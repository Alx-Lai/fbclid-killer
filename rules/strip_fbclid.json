[
  {
    "id": 1,
    "priority": 1,
    "action": {
      "type": "redirect",
      "redirect": {
        "transform": {
          "queryTransform": {
            "removeParams": [
              "fbclid",
              "fb_action_ids",
              "fb_action_types",
              "fb_source",
              "fb_ref"
            ]
          }
        }
      }
    },
    "condition": {
      "resourceTypes": [
        "main_frame",
        "sub_frame"
      ]
    }
  },
  {
    "id": 2,
    "priority": 1,
    "action": {
